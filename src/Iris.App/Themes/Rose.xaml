<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rose: rose and lilac (the same names in every theme; used as DynamicResource).
         Text colors keep at least 4.5:1 against the surfaces they stand on. -->

    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFEEF4" Offset="0" />
        <GradientStop Color="#FAEEFF" Offset="0.5" />
        <GradientStop Color="#FFF3EF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Background" Color="#FFF2F7" />
    <SolidColorBrush x:Key="Sidebar" Color="#BFFFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FCEFF5" />
    <SolidColorBrush x:Key="Border" Color="#F6E0EA" />
    <SolidColorBrush x:Key="Control" Color="#ECCADA" />
    <SolidColorBrush x:Key="Text" Color="#3A2232" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B5265" />
    <SolidColorBrush x:Key="Accent" Color="#AA2C64" />
    <SolidColorBrush x:Key="AccentHover" Color="#AA2C64" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#FFE2EE" />
    <SolidColorBrush x:Key="AccentSoftText" Color="#8A2352" />
    <SolidColorBrush x:Key="DropZone" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="DropLine" Color="#E3A8C3" />
    <SolidColorBrush x:Key="PageText" Color="#3A2232" />
    <SolidColorBrush x:Key="PageMuted" Color="#6B5265" />
    <SolidColorBrush x:Key="PageWarn" Color="#8F5300" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#AA2C64" Offset="0" />
        <GradientStop Color="#8A3BA6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A42C62" Offset="0" />
        <GradientStop Color="#7D3497" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A42C62" Offset="0" />
        <GradientStop Color="#7D3497" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" Color="#B8336F" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.1" />
    <DropShadowEffect x:Key="ButtonShadow" Color="#B8336F" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.26" />

    <!-- the pastel of each part of IRIS (soft fill) and its deeper tone -->
    <SolidColorBrush x:Key="Lavender" Color="#ECE7FF" />
    <SolidColorBrush x:Key="LavenderDeep" Color="#5B45D6" />
    <SolidColorBrush x:Key="Pink" Color="#FFE4EF" />
    <SolidColorBrush x:Key="PinkDeep" Color="#B8336F" />
    <SolidColorBrush x:Key="Peach" Color="#FFEADB" />
    <SolidColorBrush x:Key="PeachDeep" Color="#A9510F" />
    <SolidColorBrush x:Key="Mint" Color="#DDF5EA" />
    <SolidColorBrush x:Key="MintDeep" Color="#1F7A4D" />
    <SolidColorBrush x:Key="Sky" Color="#DEEEFF" />
    <SolidColorBrush x:Key="SkyDeep" Color="#2363A8" />
    <SolidColorBrush x:Key="Lilac" Color="#F3E3FB" />
    <SolidColorBrush x:Key="LilacDeep" Color="#8A3BA6" />

    <SolidColorBrush x:Key="Good" Color="#1F7A4D" />
    <SolidColorBrush x:Key="GoodSoft" Color="#E1F6EA" />
    <SolidColorBrush x:Key="GoodLine" Color="#90D4AE" />
    <SolidColorBrush x:Key="Warn" Color="#8F5300" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF3D9" />
    <SolidColorBrush x:Key="WarnLine" Color="#EDBB5A" />
    <SolidColorBrush x:Key="Danger" Color="#B42D45" />
    <SolidColorBrush x:Key="DangerLine" Color="#E3899A" />
</ResourceDictionary>
