<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- light pastel colors of IRIS (the same names in Light.xaml and Dark.xaml; used as DynamicResource).
         Text colors keep at least 4.5:1 against the surfaces they stand on. -->

    <!-- the window: a soft dawn of lavender, blush and mint -->
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F3EFFF" Offset="0" />
        <GradientStop Color="#FFF0F6" Offset="0.5" />
        <GradientStop Color="#EAF8F2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Background" Color="#F6F3FF" />
    <SolidColorBrush x:Key="Sidebar" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F1EEFB" />
    <SolidColorBrush x:Key="Border" Color="#ECE8F7" />
    <SolidColorBrush x:Key="Control" Color="#DCD6EE" />
    <SolidColorBrush x:Key="Text" Color="#28233F" />
    <SolidColorBrush x:Key="TextMuted" Color="#625D7D" />

    <SolidColorBrush x:Key="Accent" Color="#6650E0" />
    <SolidColorBrush x:Key="AccentHover" Color="#5440C8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EDE9FF" />
    <SolidColorBrush x:Key="AccentSoftText" Color="#4433B0" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6650E0" Offset="0" />
        <GradientStop Color="#A24BC8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4433B0" Offset="0" />
        <GradientStop Color="#9C3DA8" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" Color="#6650E0" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.10" />
    <DropShadowEffect x:Key="ButtonShadow" Color="#6650E0" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.28" />

    <!-- the pastel of each part of IRIS (soft fill) and its deeper tone (icons, the chosen menu item) -->
    <SolidColorBrush x:Key="Lavender" Color="#ECE7FF" />
    <SolidColorBrush x:Key="LavenderDeep" Color="#5B45D6" />
    <SolidColorBrush x:Key="Pink" Color="#FFE4EF" />
    <SolidColorBrush x:Key="PinkDeep" Color="#B8336F" />
    <SolidColorBrush x:Key="Peach" Color="#FFEADB" />
    <SolidColorBrush x:Key="PeachDeep" Color="#A9510F" />
    <SolidColorBrush x:Key="Mint" Color="#DDF5EA" />
    <SolidColorBrush x:Key="MintDeep" Color="#1F7A4D" />
    <SolidColorBrush x:Key="Sky" Color="#DEEEFF" />
    <SolidColorBrush x:Key="SkyDeep" Color="#2363A8" />
    <SolidColorBrush x:Key="Lilac" Color="#F3E3FB" />
    <SolidColorBrush x:Key="LilacDeep" Color="#8A3BA6" />

    <SolidColorBrush x:Key="Good" Color="#1F7A4D" />
    <SolidColorBrush x:Key="GoodSoft" Color="#E1F6EA" />
    <SolidColorBrush x:Key="GoodLine" Color="#90D4AE" />
    <SolidColorBrush x:Key="Warn" Color="#8F5300" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF3D9" />
    <SolidColorBrush x:Key="WarnLine" Color="#EDBB5A" />
    <SolidColorBrush x:Key="Danger" Color="#B42D45" />
    <SolidColorBrush x:Key="DangerLine" Color="#E3899A" />
    <SolidColorBrush x:Key="DropZone" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="DropLine" Color="#B8ACF2" />
    <!-- texts that stand on the window itself (outside cards) and the name in the menu -->
    <SolidColorBrush x:Key="PageText" Color="#28233F" />
    <SolidColorBrush x:Key="PageMuted" Color="#625D7D" />
    <SolidColorBrush x:Key="PageWarn" Color="#8F5300" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#4433B0" Offset="0" />
        <GradientStop Color="#9C3DA8" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
