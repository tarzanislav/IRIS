<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- dark pastel colors of IRIS (the same names in Light.xaml and Dark.xaml; used as DynamicResource) -->

    <!-- the window: a night of deep violet with a teal glow -->
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1530" Offset="0" />
        <GradientStop Color="#22172E" Offset="0.55" />
        <GradientStop Color="#122228" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Background" Color="#1B1730" />
    <SolidColorBrush x:Key="Sidebar" Color="#99231E38" />
    <SolidColorBrush x:Key="Surface" Color="#241F3A" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#2E2849" />
    <SolidColorBrush x:Key="Border" Color="#383157" />
    <SolidColorBrush x:Key="Control" Color="#4A4270" />
    <SolidColorBrush x:Key="Text" Color="#F3F0FF" />
    <SolidColorBrush x:Key="TextMuted" Color="#C2BCE0" />

    <SolidColorBrush x:Key="Accent" Color="#B9AEFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#D2CBFF" />
    <SolidColorBrush x:Key="OnAccent" Color="#1B1730" />
    <SolidColorBrush x:Key="AccentSoft" Color="#3B3270" />
    <SolidColorBrush x:Key="AccentSoftText" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C3B8FF" Offset="0" />
        <GradientStop Color="#F2B5DD" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#D4CCFF" Offset="0" />
        <GradientStop Color="#F6C3E2" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35" />
    <DropShadowEffect x:Key="ButtonShadow" Color="#000000" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.40" />

    <SolidColorBrush x:Key="Lavender" Color="#3A3168" />
    <SolidColorBrush x:Key="LavenderDeep" Color="#CFC6FF" />
    <SolidColorBrush x:Key="Pink" Color="#4A2840" />
    <SolidColorBrush x:Key="PinkDeep" Color="#FFB8D6" />
    <SolidColorBrush x:Key="Peach" Color="#4A3226" />
    <SolidColorBrush x:Key="PeachDeep" Color="#FFC9A3" />
    <SolidColorBrush x:Key="Mint" Color="#203F35" />
    <SolidColorBrush x:Key="MintDeep" Color="#A6E8C6" />
    <SolidColorBrush x:Key="Sky" Color="#1F3550" />
    <SolidColorBrush x:Key="SkyDeep" Color="#AFD3FF" />
    <SolidColorBrush x:Key="Lilac" Color="#3F2A50" />
    <SolidColorBrush x:Key="LilacDeep" Color="#E6B9F6" />

    <SolidColorBrush x:Key="Good" Color="#A6E8C6" />
    <SolidColorBrush x:Key="GoodSoft" Color="#1E3A30" />
    <SolidColorBrush x:Key="GoodLine" Color="#3E7A5C" />
    <SolidColorBrush x:Key="Warn" Color="#F6CF84" />
    <SolidColorBrush x:Key="WarnSoft" Color="#3A2E1C" />
    <SolidColorBrush x:Key="WarnLine" Color="#8C6B2A" />
    <SolidColorBrush x:Key="Danger" Color="#FFA3B4" />
    <SolidColorBrush x:Key="DangerLine" Color="#B14E62" />
    <SolidColorBrush x:Key="DropZone" Color="#66241F3A" />
    <SolidColorBrush x:Key="DropLine" Color="#6B5FB0" />
</ResourceDictionary>
