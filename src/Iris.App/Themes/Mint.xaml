<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- light colors with a soft pastel green (the same names in every theme; used as DynamicResource).
         Text colors keep at least 4.5:1 against the surfaces they stand on. -->

    <!-- the window: a fresh meadow of mint and sage -->
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6F6EC" Offset="0" />
        <GradientStop Color="#F1FAF2" Offset="0.5" />
        <GradientStop Color="#DFF2EA" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Background" Color="#EEF8F1" />
    <SolidColorBrush x:Key="Sidebar" Color="#C2FFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#EDF7F0" />
    <SolidColorBrush x:Key="Border" Color="#DCEFE3" />
    <SolidColorBrush x:Key="Control" Color="#C3E2CF" />
    <SolidColorBrush x:Key="Text" Color="#1E3328" />
    <SolidColorBrush x:Key="TextMuted" Color="#4F675A" />

    <SolidColorBrush x:Key="Accent" Color="#20744C" />
    <SolidColorBrush x:Key="AccentHover" Color="#195F3E" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#DBF2E4" />
    <SolidColorBrush x:Key="AccentSoftText" Color="#195F3E" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#20744C" Offset="0" />
        <GradientStop Color="#2C7F86" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1B6943" Offset="0" />
        <GradientStop Color="#2A7480" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" Color="#20744C" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.10" />
    <DropShadowEffect x:Key="ButtonShadow" Color="#20744C" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.26" />

    <!-- the pastel of each part of IRIS and its deeper tone (as in the light theme) -->
    <SolidColorBrush x:Key="Lavender" Color="#ECE7FF" />
    <SolidColorBrush x:Key="LavenderDeep" Color="#5B45D6" />
    <SolidColorBrush x:Key="Pink" Color="#FFE4EF" />
    <SolidColorBrush x:Key="PinkDeep" Color="#B8336F" />
    <SolidColorBrush x:Key="Peach" Color="#FFEADB" />
    <SolidColorBrush x:Key="PeachDeep" Color="#A9510F" />
    <SolidColorBrush x:Key="Mint" Color="#D4F1E0" />
    <SolidColorBrush x:Key="MintDeep" Color="#1C6B45" />
    <SolidColorBrush x:Key="Sky" Color="#DEEEFF" />
    <SolidColorBrush x:Key="SkyDeep" Color="#2363A8" />
    <SolidColorBrush x:Key="Lilac" Color="#F3E3FB" />
    <SolidColorBrush x:Key="LilacDeep" Color="#8A3BA6" />

    <SolidColorBrush x:Key="Good" Color="#1C6B45" />
    <SolidColorBrush x:Key="GoodSoft" Color="#DDF4E6" />
    <SolidColorBrush x:Key="GoodLine" Color="#86CFA6" />
    <SolidColorBrush x:Key="Warn" Color="#8F5300" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF3D9" />
    <SolidColorBrush x:Key="WarnLine" Color="#EDBB5A" />
    <SolidColorBrush x:Key="Danger" Color="#B42D45" />
    <SolidColorBrush x:Key="DangerLine" Color="#E3899A" />
    <SolidColorBrush x:Key="DropZone" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="DropLine" Color="#93CDAA" />
    <!-- texts that stand on the window itself (outside cards) and the name in the menu -->
    <SolidColorBrush x:Key="PageText" Color="#1E3328" />
    <SolidColorBrush x:Key="PageMuted" Color="#4F675A" />
    <SolidColorBrush x:Key="PageWarn" Color="#8F5300" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1B6943" Offset="0" />
        <GradientStop Color="#2A7480" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
