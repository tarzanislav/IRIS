<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- a calm blue, lighter than the dark theme (the same names in every theme; used as DynamicResource).
         Text colors keep at least 4.5:1 against the surfaces they stand on. -->

    <!-- the window: dusk blue with a hint of teal -->
    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2D4268" Offset="0" />
        <GradientStop Color="#36547F" Offset="0.55" />
        <GradientStop Color="#2C5170" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Background" Color="#30486F" />
    <SolidColorBrush x:Key="Sidebar" Color="#B33A5482" />
    <SolidColorBrush x:Key="Surface" Color="#3A5482" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#445F8E" />
    <SolidColorBrush x:Key="Border" Color="#4F6A9A" />
    <SolidColorBrush x:Key="Control" Color="#6580B0" />
    <SolidColorBrush x:Key="Text" Color="#F4F7FF" />
    <SolidColorBrush x:Key="TextMuted" Color="#D2DCF2" />

    <SolidColorBrush x:Key="Accent" Color="#BFD9FF" />
    <SolidColorBrush x:Key="AccentHover" Color="#DCEAFF" />
    <SolidColorBrush x:Key="OnAccent" Color="#1D2E4D" />
    <SolidColorBrush x:Key="AccentSoft" Color="#4F6DA0" />
    <SolidColorBrush x:Key="AccentSoftText" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BFD9FF" Offset="0" />
        <GradientStop Color="#D6CCFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DCEBFF" Offset="0" />
        <GradientStop Color="#E7DEFF" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" Color="#0E1A30" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.30" />
    <DropShadowEffect x:Key="ButtonShadow" Color="#0E1A30" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" />

    <SolidColorBrush x:Key="Lavender" Color="#525B9E" />
    <SolidColorBrush x:Key="LavenderDeep" Color="#E2DDFF" />
    <SolidColorBrush x:Key="Pink" Color="#6E4F7E" />
    <SolidColorBrush x:Key="PinkDeep" Color="#FFD1E8" />
    <SolidColorBrush x:Key="Peach" Color="#6E5C58" />
    <SolidColorBrush x:Key="PeachDeep" Color="#FFDCC2" />
    <SolidColorBrush x:Key="Mint" Color="#355F60" />
    <SolidColorBrush x:Key="MintDeep" Color="#C3F2DC" />
    <SolidColorBrush x:Key="Sky" Color="#395F90" />
    <SolidColorBrush x:Key="SkyDeep" Color="#D3E8FF" />
    <SolidColorBrush x:Key="Lilac" Color="#5E548F" />
    <SolidColorBrush x:Key="LilacDeep" Color="#F0D6FF" />

    <SolidColorBrush x:Key="Good" Color="#B9F0D3" />
    <SolidColorBrush x:Key="GoodSoft" Color="#335D5A" />
    <SolidColorBrush x:Key="GoodLine" Color="#6FB79A" />
    <SolidColorBrush x:Key="Warn" Color="#FFDE9E" />
    <SolidColorBrush x:Key="WarnSoft" Color="#5A5246" />
    <SolidColorBrush x:Key="WarnLine" Color="#B89752" />
    <SolidColorBrush x:Key="Danger" Color="#FFC2CD" />
    <SolidColorBrush x:Key="DangerLine" Color="#C77C8C" />
    <SolidColorBrush x:Key="DropZone" Color="#663A5482" />
    <SolidColorBrush x:Key="DropLine" Color="#8EA8D6" />
    <!-- texts that stand on the window itself (outside cards) and the name in the menu -->
    <SolidColorBrush x:Key="PageText" Color="#F4F7FF" />
    <SolidColorBrush x:Key="PageMuted" Color="#D2DCF2" />
    <SolidColorBrush x:Key="PageWarn" Color="#FFDE9E" />
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DCEBFF" Offset="0" />
        <GradientStop Color="#E7DEFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
