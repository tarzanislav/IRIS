<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Graphite: a graphite window with warm light cards and menu (the same names in every theme; used as DynamicResource).
         Text colors keep at least 4.5:1 against the surfaces they stand on. -->

    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1D2025" Offset="0" />
        <GradientStop Color="#252930" Offset="0.55" />
        <GradientStop Color="#1B1E23" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Background" Color="#F0EAE5" />
    <SolidColorBrush x:Key="Sidebar" Color="#E6DFDA" />
    <SolidColorBrush x:Key="Surface" Color="#FAF6F3" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F0EAE5" />
    <SolidColorBrush x:Key="Border" Color="#E3DAD3" />
    <SolidColorBrush x:Key="Control" Color="#D1C5BC" />
    <SolidColorBrush x:Key="Text" Color="#2A2626" />
    <SolidColorBrush x:Key="TextMuted" Color="#5B5451" />
    <SolidColorBrush x:Key="Accent" Color="#A2472A" />
    <SolidColorBrush x:Key="AccentHover" Color="#A2472A" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#F7E2D8" />
    <SolidColorBrush x:Key="AccentSoftText" Color="#86391F" />
    <SolidColorBrush x:Key="DropZone" Color="#FAF6F3" />
    <SolidColorBrush x:Key="DropLine" Color="#D8B8A8" />
    <SolidColorBrush x:Key="PageText" Color="#F3F3F5" />
    <SolidColorBrush x:Key="PageMuted" Color="#C5C7CF" />
    <SolidColorBrush x:Key="PageWarn" Color="#F6CF84" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A2472A" Offset="0" />
        <GradientStop Color="#A33D6C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F7D2C1" Offset="0" />
        <GradientStop Color="#F0C6DD" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#A2472A" Offset="0" />
        <GradientStop Color="#A33D6C" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.35" />
    <DropShadowEffect x:Key="ButtonShadow" Color="#000000" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.4" />

    <!-- the pastel of each part of IRIS (soft fill) and its deeper tone -->
    <SolidColorBrush x:Key="Lavender" Color="#ECE7FF" />
    <SolidColorBrush x:Key="LavenderDeep" Color="#5B45D6" />
    <SolidColorBrush x:Key="Pink" Color="#FFE4EF" />
    <SolidColorBrush x:Key="PinkDeep" Color="#B8336F" />
    <SolidColorBrush x:Key="Peach" Color="#FFEADB" />
    <SolidColorBrush x:Key="PeachDeep" Color="#A9510F" />
    <SolidColorBrush x:Key="Mint" Color="#DDF5EA" />
    <SolidColorBrush x:Key="MintDeep" Color="#1F7A4D" />
    <SolidColorBrush x:Key="Sky" Color="#DEEEFF" />
    <SolidColorBrush x:Key="SkyDeep" Color="#2363A8" />
    <SolidColorBrush x:Key="Lilac" Color="#F3E3FB" />
    <SolidColorBrush x:Key="LilacDeep" Color="#8A3BA6" />

    <SolidColorBrush x:Key="Good" Color="#1F7A4D" />
    <SolidColorBrush x:Key="GoodSoft" Color="#E1F6EA" />
    <SolidColorBrush x:Key="GoodLine" Color="#90D4AE" />
    <SolidColorBrush x:Key="Warn" Color="#8F5300" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF3D9" />
    <SolidColorBrush x:Key="WarnLine" Color="#EDBB5A" />
    <SolidColorBrush x:Key="Danger" Color="#B42D45" />
    <SolidColorBrush x:Key="DangerLine" Color="#E3899A" />
</ResourceDictionary>
