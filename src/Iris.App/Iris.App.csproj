<Project Sdk="Microsoft.NET.Sdk">
  <!-- The IRIS application for Windows (WPF, part of .NET – no packages). Everything except the window lives in
       Iris.Assistant; this project only shows it. Builds on Linux too (EnableWindowsTargeting), runs on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>iris-app</AssemblyName>
    <RootNamespace>Iris.App</RootNamespace>
    <ApplicationIcon>Assets\iris.ico</ApplicationIcon>
    <Description>IRIS – own translator for Windows: text, files, memory, glossary, offline.</Description>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Iris.Assistant\Iris.Assistant.csproj" />
    <Resource Include="Assets\iris.ico" />
    <EmbeddedResource Include="packs.json" Condition="Exists('packs.json')" LogicalName="Iris.App.packs.json" />
  </ItemGroup>
</Project>
