<Window x:Class="Iris.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Iris.App"
        Title="IRIS" Width="1240" Height="820" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/iris.ico"
        Background="{DynamicResource Background}" FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,18">
                    <Viewbox Width="28" Height="28">
                        <Canvas Width="28" Height="28">
                            <Ellipse Width="24" Height="24" Canvas.Left="2" Canvas.Top="2" Stroke="{DynamicResource Accent}" StrokeThickness="2" />
                            <Ellipse Width="10" Height="10" Canvas.Left="9" Canvas.Top="9" Fill="{DynamicResource Accent}" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="IRIS" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" x:Name="NavItems">
                    <RadioButton x:Name="NavTranslate" Style="{StaticResource NavItem}" GroupName="nav" Tag="translate"
                                 Content="{Binding [nav.translate], Source={x:Static app:Localizer.Instance}}" Checked="Navigate" />
                    <RadioButton x:Name="NavVoice" Style="{StaticResource NavItem}" GroupName="nav" Tag="voice"
                                 Content="{Binding [nav.voice], Source={x:Static app:Localizer.Instance}}" Checked="Navigate" />
                    <RadioButton x:Name="NavFiles" Style="{StaticResource NavItem}" GroupName="nav" Tag="files"
                                 Content="{Binding [nav.files], Source={x:Static app:Localizer.Instance}}" Checked="Navigate" />
                    <RadioButton x:Name="NavMemory" Style="{StaticResource NavItem}" GroupName="nav" Tag="memory"
                                 Content="{Binding [nav.memory], Source={x:Static app:Localizer.Instance}}" Checked="Navigate" />
                    <RadioButton x:Name="NavLearning" Style="{StaticResource NavItem}" GroupName="nav" Tag="learning"
                                 Content="{Binding [nav.learning], Source={x:Static app:Localizer.Instance}}" Checked="Navigate" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Tag="settings"
                                 Content="{Binding [nav.settings], Source={x:Static app:Localizer.Instance}}" Checked="Navigate" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Background}" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding [status.offline], Source={x:Static app:Localizer.Instance}}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding [status.private], Source={x:Static app:Localizer.Instance}}" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="Packs" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" x:Name="Page" Focusable="False" />
    </Grid>
</Window>
