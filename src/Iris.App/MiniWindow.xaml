<Window x:Class="Iris.App.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Iris.App"
        Title="{Binding [mini.title], Source={x:Static app:Localizer.Instance}}"
        Width="420" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Control}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" KeyDown="KeyPressed" Deactivated="Lost">
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" MinHeight="32" MinWidth="32" Padding="0" BorderThickness="0" Click="CloseClick"
                    AutomationProperties.Name="{Binding [common.close], Source={x:Static app:Localizer.Instance}}">
                <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" />
            </Button>
            <TextBlock x:Name="Direction" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="Translation" FontSize="16" TextWrapping="Wrap" LineHeight="24" MaxHeight="320" />
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="CopyButton" Style="{StaticResource Primary}" Click="CopyClick"
                    Content="{Binding [mini.copy], Source={x:Static app:Localizer.Instance}}" />
            <Button Margin="8,0,0,0" IsEnabled="False" ToolTip="{Binding [common.soon], Source={x:Static app:Localizer.Instance}}"
                    Content="{Binding [mini.read], Source={x:Static app:Localizer.Instance}}" />
            <Button x:Name="CorrectButton" Margin="8,0,0,0" Click="CorrectClick"
                    Content="{Binding [mini.correct], Source={x:Static app:Localizer.Instance}}" />
        </WrapPanel>
    </StackPanel>
</Window>
