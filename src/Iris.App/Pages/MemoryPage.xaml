<UserControl x:Class="Iris.App.Pages.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Iris.App">
    <DockPanel Margin="32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageTitle}" VerticalAlignment="Center"
                       Text="{Binding [memory.title], Source={x:Static app:Localizer.Instance}}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Text="{Binding [memory.direction], Source={x:Static app:Localizer.Instance}}" />
                <ComboBox x:Name="Direction" SelectionChanged="DirectionChanged"
                          AutomationProperties.Name="{Binding [memory.direction], Source={x:Static app:Localizer.Instance}}" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabCorrections" Style="{StaticResource NavItem}" GroupName="memoryTabs" Margin="0" Checked="TabChanged" />
                    <RadioButton x:Name="TabTerms" Style="{StaticResource NavItem}" GroupName="memoryTabs" Margin="0" Checked="TabChanged" />
                    <RadioButton x:Name="TabHistory" Style="{StaticResource NavItem}" GroupName="memoryTabs" Margin="0" Checked="TabChanged"
                                 Content="{Binding [memory.history], Source={x:Static app:Localizer.Instance}}" />
                </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Right" x:Name="Shared" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="{Binding [memory.shared], Source={x:Static app:Localizer.Instance}}" />
            <TextBox x:Name="Search" Margin="12,0,0,0" TextChanged="SearchChanged"
                     AutomationProperties.Name="{Binding [memory.search], Source={x:Static app:Localizer.Instance}}" />
        </DockPanel>

        <Border DockPanel.Dock="Bottom" x:Name="AddTerm" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" Text="{Binding [memory.term], Source={x:Static app:Localizer.Instance}}" />
                    <TextBox x:Name="Term" AutomationProperties.Name="{Binding [memory.term], Source={x:Static app:Localizer.Instance}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" Text="{Binding [memory.termTarget], Source={x:Static app:Localizer.Instance}}" />
                    <TextBox x:Name="TermTarget" AutomationProperties.Name="{Binding [memory.termTarget], Source={x:Static app:Localizer.Instance}}" />
                </StackPanel>
                <Button Grid.Column="4" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Click="AddTermClick"
                        Content="{Binding [memory.add], Source={x:Static app:Localizer.Instance}}" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" x:Name="HistoryActions" Margin="0,12,0,0">
            <Button HorizontalAlignment="Left" Click="ClearHistory" Content="{Binding [memory.clearHistory], Source={x:Static app:Localizer.Instance}}" />
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Rows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding First}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Second}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Content="{Binding Action}" Visibility="{Binding ActionVisibility}" Click="RowAction" MinHeight="34" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="Empty" Style="{StaticResource Muted}" FontSize="15" Margin="16" VerticalAlignment="Top"
                           Text="{Binding [memory.empty], Source={x:Static app:Localizer.Instance}}" />
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
