<UserControl x:Class="Iris.App.Pages.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Iris.App">
    <DockPanel Margin="32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageTitle}" VerticalAlignment="Center"
                       Text="{Binding [files.title], Source={x:Static app:Localizer.Instance}}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ComboBox x:Name="SourceLanguage" SelectionChanged="LanguageChanged"
                          AutomationProperties.Name="{Binding [translate.source], Source={x:Static app:Localizer.Instance}}" />
                <TextBlock Text="→" Margin="10,0" VerticalAlignment="Center" FontSize="16" />
                <ComboBox x:Name="TargetLanguage" SelectionChanged="LanguageChanged"
                          AutomationProperties.Name="{Binding [translate.target], Source={x:Static app:Localizer.Instance}}" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,12"
                   Text="{Binding [files.note], Source={x:Static app:Localizer.Instance}}" />

        <Border DockPanel.Dock="Top" x:Name="DropZone" AllowDrop="True" DragOver="DragFiles" Drop="DropFiles"
                Background="{DynamicResource DropZone}" BorderBrush="{DynamicResource DropLine}" BorderThickness="2"
                CornerRadius="16" Padding="24" Margin="0,0,0,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="ChooseFiles" VerticalAlignment="Center"
                        Content="{Binding [files.choose], Source={x:Static app:Localizer.Instance}}" />
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding [files.drop], Source={x:Static app:Localizer.Instance}}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"
                               Text="{Binding [files.kinds], Source={x:Static app:Localizer.Instance}}" />
                    <TextBlock x:Name="Message" Style="{StaticResource Muted}" Foreground="{DynamicResource Warn}" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="{Binding [files.file], Source={x:Static app:Localizer.Instance}}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{Binding [files.task], Source={x:Static app:Localizer.Instance}}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding [files.progress], Source={x:Static app:Localizer.Instance}}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="{Binding [files.result], Source={x:Static app:Localizer.Instance}}" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Jobs">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding Source}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Direction}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <ProgressBar Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Visibility="{Binding ProgressVisibility}"
                                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" />
                                            <TextBlock Text="{Binding State}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding [common.open], Source={x:Static app:Localizer.Instance}}" Visibility="{Binding OpenVisibility}"
                                                    Click="OpenResult" MinHeight="34" ToolTip="{Binding Result}" />
                                            <Button Content="{Binding [common.stop], Source={x:Static app:Localizer.Instance}}" Visibility="{Binding StopVisibility}"
                                                    Click="StopJob" MinHeight="34" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
