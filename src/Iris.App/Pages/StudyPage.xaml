<UserControl x:Class="Iris.App.Pages.StudyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Iris.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24">
            <DockPanel Margin="0,0,0,16" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageTitle}" VerticalAlignment="Center"
                           Text="{Binding [study.title], Source={x:Static app:Localizer.Instance}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Text="{Binding [memory.direction], Source={x:Static app:Localizer.Instance}}" />
                    <ComboBox x:Name="Direction" SelectionChanged="DirectionChanged" MinWidth="160"
                              AutomationProperties.Name="{Binding [memory.direction], Source={x:Static app:Localizer.Instance}}" />
                </StackPanel>
            </DockPanel>

            <!-- off until the owner turns it on -->
            <Border x:Name="Off" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Text="{Binding [study.offTitle], Source={x:Static app:Localizer.Instance}}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="{Binding [study.offText], Source={x:Static app:Localizer.Instance}}" />
                    <Button Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="TurnOn"
                            Content="{Binding [study.turnOn], Source={x:Static app:Localizer.Instance}}" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="On">
                <TextBlock Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="{Binding [study.note], Source={x:Static app:Localizer.Instance}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" MinHeight="32">
                            <Button DockPanel.Dock="Right" Click="FromPicture" Tag="Original" Padding="10,2" MinHeight="28"
                                    Content="{Binding [study.fromPicture], Source={x:Static app:Localizer.Instance}}" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{Binding [study.original], Source={x:Static app:Localizer.Instance}}" />
                        </DockPanel>
                        <TextBox x:Name="Original" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{Binding [study.original], Source={x:Static app:Localizer.Instance}}" />
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" MinHeight="32">
                            <Button DockPanel.Dock="Right" Click="FillIris" Padding="10,2" MinHeight="28"
                                    Content="{Binding [study.irisTranslation], Source={x:Static app:Localizer.Instance}}" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{Binding [study.other], Source={x:Static app:Localizer.Instance}}" />
                        </DockPanel>
                        <TextBox x:Name="Other" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource SurfaceAlt}"
                                 AutomationProperties.Name="{Binding [study.other], Source={x:Static app:Localizer.Instance}}" />
                    </DockPanel>
                    <DockPanel Grid.Column="4">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" MinHeight="32">
                            <Button DockPanel.Dock="Right" Click="FromPicture" Tag="Verified" Padding="10,2" MinHeight="28"
                                    Content="{Binding [study.fromPicture], Source={x:Static app:Localizer.Instance}}" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{Binding [study.verified], Source={x:Static app:Localizer.Instance}}" />
                        </DockPanel>
                        <TextBox x:Name="Verified" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto"
                                 BorderBrush="{DynamicResource GoodLine}"
                                 AutomationProperties.Name="{Binding [study.verified], Source={x:Static app:Localizer.Instance}}" />
                    </DockPanel>
                </Grid>

                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="PairSentences" x:Name="PairButton" Margin="12,0,0,0"
                            Content="{Binding [study.pair], Source={x:Static app:Localizer.Instance}}" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Text="{Binding [study.label], Source={x:Static app:Localizer.Instance}}" />
                    <TextBox x:Name="BookLabel" AutomationProperties.Name="{Binding [study.label], Source={x:Static app:Localizer.Instance}}" />
                </DockPanel>
                <TextBlock x:Name="Message" Style="{StaticResource Muted}" Foreground="{DynamicResource Warn}" Margin="0,6,0,0" TextWrapping="Wrap" />

                <Border x:Name="PairsCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0" Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl x:Name="Pairs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Take}" VerticalAlignment="Top" Margin="0,2,10,0"
                                                      AutomationProperties.Name="{Binding Source}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Source}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{Binding Target}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="4" Text="{Binding Sureness}" Style="{StaticResource Muted}" Margin="12,0,0,0"
                                                       Foreground="{Binding SurenessBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="16,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="SavePairs"
                                    Content="{Binding [study.save], Source={x:Static app:Localizer.Instance}}" />
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{Binding [study.check], Source={x:Static app:Localizer.Instance}}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" Text="{Binding [study.learnTitle], Source={x:Static app:Localizer.Instance}}" />
                        <TextBlock x:Name="Counts" FontSize="14" Margin="0,0,0,4" />
                        <TextBlock x:Name="Last" Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ProgressBar x:Name="LearnProgress" Height="4" Maximum="100" Visibility="Collapsed" Margin="0,0,0,10"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" />
                        <WrapPanel>
                            <Button x:Name="LearnButton" Style="{StaticResource Primary}" Click="Learn"
                                    Content="{Binding [study.learn], Source={x:Static app:Localizer.Instance}}" />
                            <Button x:Name="StopButton" Margin="8,0,0,0" Click="Stop" Visibility="Collapsed"
                                    Content="{Binding [study.stop], Source={x:Static app:Localizer.Instance}}" />
                            <CheckBox x:Name="UseLearned" Margin="16,0,0,0" VerticalAlignment="Center" Click="UseLearnedChanged"
                                      Content="{Binding [study.useLearned], Source={x:Static app:Localizer.Instance}}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
