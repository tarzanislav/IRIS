<UserControl x:Class="Iris.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Iris.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24">
            <TextBlock Style="{StaticResource PageTitle}" Margin="0,0,0,18" Text="{Binding [settings.title], Source={x:Static app:Localizer.Instance}}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Text="{Binding [settings.general], Source={x:Static app:Localizer.Instance}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" Text="{Binding [settings.language], Source={x:Static app:Localizer.Instance}}" />
                        <ComboBox x:Name="InterfaceLanguage" SelectionChanged="InterfaceLanguageChanged" Margin="0,0,0,14"
                                  AutomationProperties.Name="{Binding [settings.language], Source={x:Static app:Localizer.Instance}}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" Text="{Binding [settings.theme], Source={x:Static app:Localizer.Instance}}" />
                        <ComboBox x:Name="ThemeChoice" SelectionChanged="ThemeChanged" Margin="0,0,0,14"
                                  AutomationProperties.Name="{Binding [settings.theme], Source={x:Static app:Localizer.Instance}}">
                            <ComboBoxItem Content="{Binding [settings.themeSystem], Source={x:Static app:Localizer.Instance}}" />
                            <ComboBoxItem Content="{Binding [settings.themeLight], Source={x:Static app:Localizer.Instance}}" />
                            <ComboBoxItem Content="{Binding [settings.themeDark], Source={x:Static app:Localizer.Instance}}" />
                        </ComboBox>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource Background}" BorderBrush="{DynamicResource Control}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,2">
                                <TextBlock x:Name="Shortcut" FontSize="13" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Text="{Binding [settings.shortcut], Source={x:Static app:Localizer.Instance}}" />
                        </DockPanel>
                        <TextBlock x:Name="ShortcutNote" Style="{StaticResource Muted}" Foreground="{DynamicResource Warn}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Text="{Binding [settings.privacy], Source={x:Static app:Localizer.Instance}}" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,10" Text="{Binding [settings.privacyText], Source={x:Static app:Localizer.Instance}}" />
                        <CheckBox x:Name="SaveHistory" Click="SaveHistoryChanged" Margin="0,0,0,12"
                                  Content="{Binding [settings.saveHistory], Source={x:Static app:Localizer.Instance}}" />
                        <Button Style="{StaticResource Danger}" HorizontalAlignment="Left" Click="DeleteAll"
                                Content="{Binding [settings.deleteAll], Source={x:Static app:Localizer.Instance}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Text="{Binding [settings.packs], Source={x:Static app:Localizer.Instance}}" />
                        <ItemsControl x:Name="Packs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="PackAction" MinHeight="34" />
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" />
                                            <ProgressBar Height="4" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Visibility="{Binding ProgressVisibility}" Margin="0,4,0,0"
                                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceAlt}" BorderThickness="0" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoCatalog" Style="{StaticResource Muted}" Margin="0,0,0,10" Text="{Binding [settings.noCatalog], Source={x:Static app:Localizer.Instance}}" />
                        <Button HorizontalAlignment="Left" Click="InstallFromFile" Content="{Binding [settings.installFile], Source={x:Static app:Localizer.Instance}}" />
                        <TextBlock x:Name="PackMessage" Style="{StaticResource Muted}" Foreground="{DynamicResource Warn}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" Text="{Binding [settings.about], Source={x:Static app:Localizer.Instance}}" />
                        <TextBlock x:Name="Version" FontSize="14" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="14" Text="{Binding [settings.aboutText], Source={x:Static app:Localizer.Instance}}" />
                        <TextBlock Margin="0,10,0,0">
                            <Hyperlink NavigateUri="https://github.com/tarzanislav/IRIS" RequestNavigate="OpenLink" Foreground="{DynamicResource Accent}">github.com/tarzanislav/IRIS</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
