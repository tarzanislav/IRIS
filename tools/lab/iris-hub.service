# systemd unit of the IRIS hub (the server of the classroom learning). Copy to /etc/systemd/system/iris-hub.service,
# put iris-hub (published for linux-x64) into /opt/iris-hub, then: systemctl daemon-reload && systemctl enable --now iris-hub
# The hub needs no root: it runs as its own user and keeps everything in /var/lib/iris-hub.
[Unit]
Description=IRIS hub – learning in the classroom
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
StateDirectory=iris-hub
ExecStart=/opt/iris-hub/iris-hub run --folder /var/lib/iris-hub
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
