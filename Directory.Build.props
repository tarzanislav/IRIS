<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- IRIS has no packages: nothing to audit, and the build does not contact nuget.org for it -->
    <NuGetAudit>false</NuGetAudit>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.0</Version>
    <Company>tarzanislav</Company>
    <Product>IRIS</Product>
    <Copyright>© 2026 tarzanislav</Copyright>
    <NeutralLanguage>sk</NeutralLanguage>
  </PropertyGroup>
</Project>
