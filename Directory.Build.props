<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- the package audit needs nuget.org; IRIS has no packages, an unreachable audit is no error -->
    <WarningsNotAsErrors>NU1900</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.1.0</Version>
    <Company>tarzanislav</Company>
    <Product>IRIS</Product>
    <Copyright>© 2026 tarzanislav</Copyright>
    <NeutralLanguage>sk</NeutralLanguage>
  </PropertyGroup>
</Project>
